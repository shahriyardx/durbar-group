# Database
DATABASE_URL="postgresql://durbar:durbar@localhost:5433/durbar"

# Better Auth
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Discord OAuth application (Developer Portal > OAuth2)
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Discord bot belonging to the same application.
# Needs Manage Roles + Manage Channels + Create Instant Invite in the guild.
DISCORD_BOT_TOKEN=""
DISCORD_GUILD_ID=""

# An hourly Upstash QStash schedule calls /api/cron?key=<this>, which is what
# posts tasks whose start time has arrived. Generate with `openssl rand -hex 32`.
# Without it that route returns 503 and tasks are only published when an admin
# opens the tasks page or hits "Publish now".
CRON_SECRET=""
