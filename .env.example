# Database
DATABASE_URL="postgresql://durbar:durbar@localhost:5433/durbar"

# Better Auth
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Discord OAuth application (Developer Portal > OAuth2)
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Discord bot belonging to the same application.
# Needs Manage Roles + Manage Channels + Create Instant Invite in the guild.
DISCORD_BOT_TOKEN=""
DISCORD_GUILD_ID=""

# Upstash QStash drives /api/cron/publish-tasks on an hourly schedule, which is
# what posts tasks whose start time has arrived. Copy both signing keys from
# https://console.upstash.com/qstash.
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# Optional fallback for the same route, for curl or a different scheduler:
# Authorization: Bearer $CRON_SECRET. With neither this nor the QStash keys set,
# the route returns 503 and tasks are only published when an admin opens the
# tasks page or hits "Publish now".
CRON_SECRET=""
